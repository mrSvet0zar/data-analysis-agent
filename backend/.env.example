# --- Anthropic (required) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
# USD price per 1M tokens, used to estimate cost per analysis (defaults suit Sonnet).
PRICE_INPUT_PER_MTOK=3.0
PRICE_OUTPUT_PER_MTOK=15.0

# --- Server ---
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex to also allow origins, e.g. Vercel previews:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
LOG_LEVEL=INFO

# --- Auth / limits ---
# If set, callers must send `Authorization: Bearer <token>` or `X-API-Key`.
# Leave empty for open local dev.
API_AUTH_TOKEN=
RATE_LIMIT=20/minute
MAX_CONCURRENT_JOBS=4

# --- Files ---
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# --- Job persistence ---
# Default: SQLite at DB_PATH. On an ephemeral host (Railway), point this at a
# mounted volume (e.g. /data/jobs.db) so job history survives restarts.
DB_PATH=./jobs.db
# Set DATABASE_URL to use PostgreSQL instead of SQLite. Railway's Postgres
# plugin injects this automatically. Required if you run more than one replica:
# a SQLite file on a volume can't be shared across instances.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
MAX_FILE_SIZE=52428800
MAX_ROWS=1000000
SAMPLE_OVER_ROWS=200000

# --- Agent ---
MAX_ITERATIONS=12
JOB_TIMEOUT_SECONDS=180
ANTHROPIC_MAX_RETRIES=4
JOB_TTL_SECONDS=86400
